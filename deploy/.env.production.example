# Copy to deploy/.env on the VPS and fill in EVERY value. Never commit the real file.
# Generate secrets with:   openssl rand -hex 24        (database/redis/CA passwords - hex only, no special characters)
#                          openssl rand -base64 48     (JWT signing key)

# --- Domain -------------------------------------------------------------------------------------------
# Web app:      https://<SOLVIX_DOMAIN>
# Agents (mTLS): https://agents.<SOLVIX_DOMAIN>     -> create DNS A/AAAA records for BOTH names pointing at the VPS
SOLVIX_DOMAIN=solvix.example.com
# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=ops@example.com

# --- Secrets ------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
SOLVIX_DB_MIGRATOR_PASSWORD=
SOLVIX_DB_APP_PASSWORD=
REDIS_PASSWORD=
SOLVIX_JWT_SIGNING_KEY=
# Password protecting the device CA private key (device-ca.pfx on the solvix-pki volume).
SOLVIX_DEVICE_CA_PASSWORD=

# --- Agents -------------------------------------------------------------------------------------------
# The device CA is generated once on the solvix-pki volume. BACK THAT VOLUME UP (scripts/backup.sh):
# losing it means every enrolled device must re-enroll.
SOLVIX_DEVICE_CA_AUTOGENERATE=true
# Enrollment attempts per client IP and minute.
SOLVIX_ENROLLMENT_RATE_LIMIT=30
# Package served on the Enrollment page. Default = unsigned build inside the image. After copying a code-signed
# Solvix.Agent.exe (+ appsettings.json) into deploy/agent-package, set this to /opt/solvix/signed-agent.
SOLVIX_AGENT_PACKAGE_DIR=/opt/solvix/agent-package

# --- Optional -----------------------------------------------------------------------------------------
# Image tag; scripts/deploy.sh sets it to the git commit automatically.
# SOLVIX_VERSION=latest
# HTTP_PORT=80
# HTTPS_PORT=443
