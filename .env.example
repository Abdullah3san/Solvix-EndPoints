# ---------------------------------------------------------------------------
# Solvix EndPoints - local development environment
# Copy to `.env` and adjust. Docker Compose reads this file automatically.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (container superuser, used ONLY by the init script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=solvix

# Application roles created by docker/postgres/init/01-roles.sql
# - migrator: owns the schema, runs EF Core migrations
# - app: runtime role, NOT a superuser, subject to Row-Level Security
SOLVIX_DB_MIGRATOR_USER=solvix_migrator
SOLVIX_DB_MIGRATOR_PASSWORD=solvix_migrator_dev
SOLVIX_DB_APP_USER=solvix_app
SOLVIX_DB_APP_PASSWORD=solvix_app_dev

# Redis
REDIS_PASSWORD=solvix_redis_dev

# API
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080
# Minimum 32 characters. Generate: openssl rand -base64 48
SOLVIX_JWT_SIGNING_KEY=dev-only-change-me-dev-only-change-me-dev-only-change-me
SOLVIX_JWT_ISSUER=solvix-endpoints
SOLVIX_JWT_AUDIENCE=solvix-endpoints-web
SOLVIX_JWT_ACCESS_TOKEN_MINUTES=60
SOLVIX_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web (Next.js)
WEB_PORT=3000
# Server-side URL the Next.js BFF uses to reach the API (inside compose network)
SOLVIX_API_INTERNAL_URL=http://api:8080

# ---------------------------------------------------------------------------
# Mobile device management (Phase 08) - all optional for local development.
# Android and Apple stay disabled until their provider settings are filled in.
# ---------------------------------------------------------------------------
# Production REQUIRES a key: base64 of 32 random bytes. Generate: openssl rand -base64 32
SOLVIX_MDM_SECRET_KEY=
# Public https URL devices use to reach the API (enrollment profiles embed it).
SOLVIX_MDM_PUBLIC_BASE_URL=http://localhost:8080
# Four-eyes approval for retire/wipe. Only enable for single-administrator workspaces.
SOLVIX_MDM_ALLOW_SELF_APPROVAL=false
# Periodic inventory sync / command reconciliation / compliance re-evaluation.
SOLVIX_MDM_SYNC_ENABLED=false
# Android Enterprise: Google Cloud project + service account key JSON (one line).
SOLVIX_MDM_ANDROID_PROJECT_ID=
SOLVIX_MDM_ANDROID_SERVICE_ACCOUNT_JSON=
# Apple MDM: APNs MDM push certificate topic + SCEP identity issuance.
SOLVIX_MDM_APPLE_PUSH_TOPIC=
SOLVIX_MDM_APPLE_PUSH_CERT_PATH=
SOLVIX_MDM_APPLE_PUSH_CERT_PASSWORD=
SOLVIX_MDM_APPLE_SCEP_URL=
SOLVIX_MDM_APPLE_SCEP_CHALLENGE=
SOLVIX_MDM_APPLE_IDENTITY_CA_PEM=
