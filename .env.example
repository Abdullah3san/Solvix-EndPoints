# ---------------------------------------------------------------------------
# Solvix EndPoints - local development environment
# Copy to `.env` and adjust. Docker Compose reads this file automatically.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (container superuser, used ONLY by the init script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=solvix

# Application roles created by docker/postgres/init/01-roles.sql
# - migrator: owns the schema, runs EF Core migrations
# - app: runtime role, NOT a superuser, subject to Row-Level Security
SOLVIX_DB_MIGRATOR_USER=solvix_migrator
SOLVIX_DB_MIGRATOR_PASSWORD=solvix_migrator_dev
SOLVIX_DB_APP_USER=solvix_app
SOLVIX_DB_APP_PASSWORD=solvix_app_dev

# Redis
REDIS_PASSWORD=solvix_redis_dev

# API
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080
# Minimum 32 characters. Generate: openssl rand -base64 48
SOLVIX_JWT_SIGNING_KEY=dev-only-change-me-dev-only-change-me-dev-only-change-me
SOLVIX_JWT_ISSUER=solvix-endpoints
SOLVIX_JWT_AUDIENCE=solvix-endpoints-web
# Access tokens are short-lived; the refresh token and the server-side session carry the sign-in.
SOLVIX_JWT_ACCESS_TOKEN_MINUTES=15
SOLVIX_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Device management (Phase 03)
# Agents connect to https://<host>:API_AGENT_PORT with mutual TLS.
API_AGENT_PORT=8443
# Development: self-signed agent TLS certificate + auto-generated device CA on the solvix-pki volume.
# Production: set both generators to false and mount a real TLS certificate and a managed CA bundle
# (Solvix__Devices__CertificateAuthority__PfxPath / PfxPassword from a secret store).
SOLVIX_AGENT_TLS_GENERATE=true
SOLVIX_AGENT_TLS_HOSTNAMES=localhost,127.0.0.1,api
SOLVIX_AGENT_TLS_PASSWORD=dev-only-agent-tls
SOLVIX_DEVICE_CA_AUTOGENERATE=true
SOLVIX_DEVICE_CA_PASSWORD=dev-only-device-ca
# Remote management (Phase 06): command signing key generated on the solvix-pki volume in development.
# Production: false, and provide Solvix__RemoteManagement__CommandSigning__KeyPem from a secret store.
SOLVIX_COMMAND_KEY_AUTOGENERATE=true
# The production stack (docker-compose.prod.yml) never auto-generates any of these: it reads the agent
# TLS certificate, device CA and command signing key from file secrets. See .env.production.example
# (SOLVIX_AGENT_PORT, SOLVIX_DEVICE_CA_PASSWORD, SOLVIX_SECRETS_DIR) and docs/DEPLOYMENT-VPS.md.

# Identity
# Encrypts MFA secrets and keys recovery-code hashes at rest. Minimum 32 characters, must stay
# stable (changing it invalidates every enrolled authenticator) and must differ from the JWT key.
# Generate: openssl rand -base64 48
SOLVIX_IDENTITY_DATA_PROTECTION_KEY=dev-only-data-protection-key-change-me-0123456789
# Public URL of the web app; links in e-mails (verification, password reset, invitations) point here.
SOLVIX_WEB_BASE_URL=http://localhost:3000
# "false" lets new accounts sign in before confirming their e-mail address. Keep "true" outside local development.
SOLVIX_REQUIRE_EMAIL_VERIFICATION=true

# E-mail. The compose stack ships Mailpit, a local SMTP sink: read captured mail at http://localhost:8025
SOLVIX_SMTP_HOST=mailpit
SOLVIX_SMTP_PORT=1025
SOLVIX_SMTP_SECURITY=None
SOLVIX_SMTP_USERNAME=
SOLVIX_SMTP_PASSWORD=
SOLVIX_EMAIL_FROM=no-reply@solvix.local
MAILPIT_UI_PORT=8025

# Proxies allowed to state the real client address (X-Forwarded-For): the web container.
# Docker's default bridge pools. Narrow these to your actual network in production.
SOLVIX_TRUSTED_PROXY_1=172.16.0.0/12
SOLVIX_TRUSTED_PROXY_2=192.168.0.0/16

# Asset management (Phase 05)
# Public web URL encoded in asset QR codes (a phone camera then opens the asset after sign-in).
# Leave empty to encode "SOLVIX-ASSET:<tag>", which the in-app audit scanner understands.
SOLVIX_ASSET_LABEL_BASE_URL=

# Web (Next.js)
WEB_PORT=3000
# Server-side URL the Next.js BFF uses to reach the API (inside compose network)
SOLVIX_API_INTERNAL_URL=http://api:8080
# Marks session cookies Secure and gives them the __Host- prefix. Must be "true" whenever the
# site is served over HTTPS; "false" only for plain-HTTP local development.
SOLVIX_COOKIE_SECURE=false
