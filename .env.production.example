# ---------------------------------------------------------------------------
# Solvix EndPoints - production (VPS) environment template
# Copy to `.env.production` on the server and replace every CHANGE_ME value.
# Never commit the real file. Generate secrets with: openssl rand -base64 48
# ---------------------------------------------------------------------------

# Public domain pointing (A record) at the VPS. Caddy issues the TLS certificate for it.
# No domain yet? Use IP-only HTTP testing instead:
#   SOLVIX_DOMAIN=:80
#   SOLVIX_PUBLIC_ORIGIN=http://<VPS_IP>
#   SOLVIX_COOKIE_SECURE=false
SOLVIX_DOMAIN=app.example.com
# Public origin the browser uses (must match SOLVIX_DOMAIN over https).
SOLVIX_PUBLIC_ORIGIN=https://app.example.com
# Keep true once HTTPS is live. Must be false for plain-HTTP IP testing.
SOLVIX_COOKIE_SECURE=true

# PostgreSQL superuser (used only by the init script that creates the app roles)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=solvix

# Application roles created by docker/postgres/init/01-roles.sh
SOLVIX_DB_MIGRATOR_USER=solvix_migrator
SOLVIX_DB_MIGRATOR_PASSWORD=CHANGE_ME
SOLVIX_DB_APP_USER=solvix_app
SOLVIX_DB_APP_PASSWORD=CHANGE_ME

# Redis (password protected, not published to the host)
REDIS_PASSWORD=CHANGE_ME

# API auth. Signing key: minimum 32 characters.
SOLVIX_JWT_SIGNING_KEY=CHANGE_ME
SOLVIX_JWT_ISSUER=solvix-endpoints
SOLVIX_JWT_AUDIENCE=solvix-endpoints-web
SOLVIX_JWT_ACCESS_TOKEN_MINUTES=60
