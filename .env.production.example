# Production settings for docker-compose.prod.yml on a single VPS.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Generate each secret with:  openssl rand -hex 32
# Never commit .env.production.

# --- Public address -----------------------------------------------------------
# The DNS A (and AAAA, if any) record of this name must point at the VPS before
# the first start, so Caddy can obtain the Let's Encrypt certificate.
SOLVIX_DOMAIN=app.example.com
# Let's Encrypt account e-mail (certificate expiry notices).
SOLVIX_ACME_EMAIL=admin@example.com

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=
SOLVIX_DB_MIGRATOR_PASSWORD=
SOLVIX_DB_APP_PASSWORD=

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=

# --- Application secrets ------------------------------------------------------
# Signs access tokens. Changing it only forces a token refresh; sessions survive.
SOLVIX_JWT_SIGNING_KEY=
# Encrypts MFA secrets at rest. It MUST never change and MUST be backed up outside
# the server: losing or changing it breaks every enrolled authenticator app.
SOLVIX_IDENTITY_DATA_PROTECTION_KEY=

# --- E-mail (verification, password reset, invitations, security alerts) ------
# Use a transactional mail provider (Postmark, Amazon SES, Mailgun, Brevo, ...)
# with SPF/DKIM set up for the sender domain. Mail sent straight from a VPS IP
# usually lands in spam, and many hosts block outbound port 25 anyway.
SOLVIX_EMAIL_FROM=no-reply@example.com
SOLVIX_EMAIL_FROM_NAME=Solvix
SOLVIX_SMTP_HOST=smtp.example.com
SOLVIX_SMTP_PORT=587
# StartTls (port 587) or SslOnConnect (port 465)
SOLVIX_SMTP_SECURITY=StartTls
SOLVIX_SMTP_USERNAME=
SOLVIX_SMTP_PASSWORD=

# Name shown in authenticator apps.
SOLVIX_MFA_ISSUER=Solvix

# --- Windows agents (Phase 03) and remote management (Phase 06) ---------------
# Agents connect to https://SOLVIX_DOMAIN:SOLVIX_AGENT_PORT with mutual TLS,
# terminated by the API itself (no proxy, no forwarded certificate header).
# The port must be reachable from every managed device; Docker publishes it
# regardless of UFW. The server certificate is Caddy's certificate for
# SOLVIX_DOMAIN, installed by scripts/sync-agent-tls.sh.
SOLVIX_AGENT_PORT=8443
# Encrypts secrets/device-ca.pfx (created once by scripts/init-agent-pki.sh).
# It MUST never change and MUST be backed up with the CA file: without both,
# every device has to be re-enrolled.
SOLVIX_DEVICE_CA_PASSWORD=
# Public key (base64 SubjectPublicKeyInfo) of the standby command signing key,
# printed by scripts/init-agent-pki.sh. Set it BEFORE enrolling devices: agents
# pin the key set once, and this is what allows rotating the command key later
# without re-enrolling every device. The standby private key stays off the server.
SOLVIX_COMMAND_STANDBY_PUBLIC_KEY=
# Directory holding the file secrets mounted into the API container:
#   agent-tls.crt / agent-tls.key   agent endpoint TLS certificate (sync-agent-tls.sh)
#   device-ca.pfx                   device CA bundle                (init-agent-pki.sh)
#   command-signing.pem             command signing key, P-256      (init-agent-pki.sh)
# Files must be owned by uid 1654 (the API container user) with mode 0600; the
# scripts take care of that. Keep it outside git (./secrets is git-ignored).
SOLVIX_SECRETS_DIR=./secrets
