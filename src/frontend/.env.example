# Server-side only: where the Next.js BFF reaches the Solvix API.
SOLVIX_API_INTERNAL_URL=http://localhost:8080
# Set to "true" to mark the session cookie Secure (always on in production).
SOLVIX_COOKIE_SECURE=false
# Agent endpoint (mutual TLS) shown in enrollment instructions, and the optional
# SHA-256 pin of its certificate when it is self-signed (development / private PKI).
SOLVIX_AGENT_SERVER_URL=https://localhost:8443/
SOLVIX_AGENT_SERVER_CERT_SHA256=
