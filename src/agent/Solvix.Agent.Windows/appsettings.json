{
  "Solvix": {
    "Agent": {
      "ServerUrl": "https://solvix.example.com/",
      "ScanIntervalHours": 6,
      "ConfigurationEvaluationMinutes": 15,
      "MinimumPollSeconds": 30,
      "MaxAllowedRisk": "Destructive"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
