<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!--
    The Solvix endpoint agent as a Windows service (LocalSystem). Uses only
    Windows-supported management interfaces: Windows Update Agent API (COM),
    Service Control Manager (advapi32), the registry, Windows Defender Firewall
    API (INetFwPolicy2 COM), Power Management API (powrprof) and shutdown.exe.
    Builds on any OS (EnableWindowsTargeting); runs on Windows 10/11 and Server 2016+.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Solvix.Agent</AssemblyName>
    <RootNamespace>Solvix.Agent.Windows</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UserSecretsId>solvix-agent-windows</UserSecretsId>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Solvix.Agent.Core\Solvix.Agent.Core.csproj" />
  </ItemGroup>
</Project>
