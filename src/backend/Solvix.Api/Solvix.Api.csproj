  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Solvix.Infrastructure\Solvix.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Solvix.IntegrationTests" />
