{
  "ConnectionStrings": {
    "Postgres": "",
    "PostgresMigrator": "",
    "Redis": ""
  },
  "Solvix": {
    "Database": {
      "MigrateOnStartup": false,
      "EnableSensitiveDataLogging": false,
      "CommandTimeoutSeconds": 30
    },
    "Redis": {
      "InstanceName": "solvix:"
    },
    "Jwt": {
      "SigningKey": "",
      "Issuer": "solvix-endpoints",
      "Audience": "solvix-endpoints-web",
      "AccessTokenMinutes": 60
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Logging": {
      "Format": "json"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
