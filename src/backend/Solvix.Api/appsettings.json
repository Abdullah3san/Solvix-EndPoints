{
  "ConnectionStrings": {
    "Postgres": "",
    "PostgresMigrator": "",
    "Redis": ""
  },
  "Solvix": {
    "Database": {
      "MigrateOnStartup": false,
      "EnableSensitiveDataLogging": false,
      "CommandTimeoutSeconds": 30
    },
    "Redis": {
      "InstanceName": "solvix:"
    },
    "Jwt": {
      "SigningKey": "",
      "Issuer": "solvix-endpoints",
      "Audience": "solvix-endpoints-web",
      "AccessTokenMinutes": 60
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Logging": {
      "Format": "json"
    },
    "Assistant": {
      "Llm": {
        "BaseUrl": "https://api.anthropic.com",
        "ApiKey": "",
        "Model": "claude-sonnet-5-5",
        "MaxOutputTokens": 2048,
        "TimeoutSeconds": 60
      },
      "MaxToolIterations": 6,
      "ChatPermitsPerMinute": 20,
      "UseDemoFleet": false,
      "Remediation": {
        "ProposalTtlMinutes": 1440,
        "MaxTargetsPerProposal": 100,
        "HighRiskTargetThreshold": 25,
        "AutoExecuteReadOnly": false
      },
      "Knowledge": {
        "MaxUploadBytes": 10485760,
        "MaxDocumentsPerTenant": 500,
        "Embeddings": {
          "Provider": "local"
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
