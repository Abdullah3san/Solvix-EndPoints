{
  "ConnectionStrings": {
    "Postgres": "",
    "PostgresMigrator": "",
    "Redis": ""
  },
  "Solvix": {
    "Database": {
      "MigrateOnStartup": false,
      "EnableSensitiveDataLogging": false,
      "CommandTimeoutSeconds": 30
    },
    "Redis": {
      "InstanceName": "solvix:"
    },
    "Jwt": {
      "SigningKey": "",
      "Issuer": "solvix-endpoints",
      "Audience": "solvix-endpoints-web",
      "AccessTokenMinutes": 60
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Logging": {
      "Format": "json"
    },
    "Devices": {
      "CertificateAuthority": {
        "PfxPath": "",
        "PfxBase64": "",
        "PfxPassword": "",
        "AutoGenerate": false,
        "DeviceCertificateLifetimeDays": 90,
        "RenewalWindowDays": 30
      },
      "Enrollment": {
        "DefaultTokenLifetimeHours": 24,
        "MaxTokenLifetimeHours": 168,
        "MaxTokenUses": 10000,
        "RateLimitPerMinute": 30
      },
      "Agent": {
        "HeartbeatIntervalSeconds": 60,
        "InventoryIntervalMinutes": 240,
        "UpdateCheckIntervalMinutes": 360,
        "DefaultUpdateChannel": "stable"
      },
      "Monitoring": {
        "DefaultWarningAfterSeconds": 120,
        "DefaultOfflineAfterSeconds": 300,
        "RunMonitor": true,
        "SweepIntervalSeconds": 15,
        "FlushIntervalSeconds": 5,
        "SignalPersistIntervalSeconds": 300,
        "OutageDetectionSeconds": 60,
        "MaxRecoveryGraceSeconds": 900,
        "EventRetentionDays": 180,
        "AvailabilityRetentionDays": 400,
        "SweepBatchSize": 2000,
        "RedisBackplane": false
      },
      "ForwardedClientCertificateHeader": "",
      "Releases": []
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}