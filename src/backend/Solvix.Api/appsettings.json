{
  "ConnectionStrings": {
    "Postgres": "",
    "PostgresMigrator": "",
    "Redis": ""
  },
  "Solvix": {
    "Database": {
      "MigrateOnStartup": false,
      "EnableSensitiveDataLogging": false,
      "CommandTimeoutSeconds": 30
    },
    "Redis": {
      "InstanceName": "solvix:"
    },
    "Jwt": {
      "SigningKey": "",
      "Issuer": "solvix-endpoints",
      "Audience": "solvix-endpoints-web",
      "AccessTokenMinutes": 15
    },
    "Identity": {
      "DataProtectionKey": "",
      "WebBaseUrl": "http://localhost:3000",
      "MfaIssuer": "Solvix",
      "RequireEmailVerification": true,
      "EmailVerificationTokenHours": 24,
      "PasswordResetTokenMinutes": 60,
      "InvitationDays": 7,
      "MfaChallengeMinutes": 5,
      "MfaChallengeMaxAttempts": 5,
      "EmailCooldownSeconds": 60,
      "RefreshTokenReuseGraceSeconds": 10,
      "Lockout": {
        "MaxFailedAttempts": 5,
        "DurationMinutes": 15,
        "MaxDurationMinutes": 1440
      },
      "Password": {
        "MinLength": 10,
        "RequireUppercase": false,
        "RequireLowercase": true,
        "RequireDigit": true,
        "RequireSymbol": false,
        "HistoryCount": 5,
        "HashIterations": 210000
      },
      "Session": {
        "IdleTimeoutMinutes": 480,
        "AbsoluteLifetimeHours": 168
      }
    },
    "Email": {
      "FromAddress": "no-reply@solvix.local",
      "FromName": "Solvix",
      "LogMessageBodies": false,
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Username": "",
        "Password": "",
        "Security": "StartTls"
      }
    },
    "RateLimiting": {
      "Enabled": true,
      "Credentials": { "PermitLimit": 10, "WindowSeconds": 60 },
      "Email": { "PermitLimit": 5, "WindowSeconds": 900 },
      "Refresh": { "PermitLimit": 120, "WindowSeconds": 60 },
      "Registration": { "PermitLimit": 20, "WindowSeconds": 600 }
    },
    "Network": {
      "TrustedProxies": [],
      "ForwardLimit": 1
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Logging": {
      "Format": "json"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
