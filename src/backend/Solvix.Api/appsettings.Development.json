{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=solvix;Username=solvix_app;Password=solvix_app_dev",
    "PostgresMigrator": "Host=localhost;Port=5432;Database=solvix;Username=solvix_migrator;Password=solvix_migrator_dev",
    "Redis": "localhost:6379,password=solvix_redis_dev"
  },
  "Solvix": {
    "Database": {
      "MigrateOnStartup": true,
      "EnableSensitiveDataLogging": true
    },
    "Jwt": {
      "SigningKey": "dev-only-change-me-dev-only-change-me-dev-only-change-me"
    },
    "Identity": {
      "DataProtectionKey": "dev-only-data-protection-key-change-me-0123456789"
    },
    "Email": {
      "LogMessageBodies": true
    },
    "Network": {
      "TrustedProxies": [ "127.0.0.1", "::1" ]
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000"
      ]
    },
    "Logging": {
      "Format": "text"
    },
    "Devices": {
      "CertificateAuthority": {
        "AutoGenerate": true,
        "PfxPath": ".solvix/device-ca.pfx",
        "PfxPassword": "dev-only-device-ca"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}